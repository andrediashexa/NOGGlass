# Secrets and local configuration
.env
.env.*
!.env.example
*.bak-*
nogglass.conf
routers.conf
ui.conf
!*.example.conf
nogglass.toml
# Lab inventories are sample configs for the reproducible harnesses, not real
# deployment secrets, so they are tracked deliberately.
!lab/*/nogglass.toml
routers.yml

# Rust build output. Without this, a `git add -A` at the workspace root
# commits hundreds of megabytes of build artefacts, which GitHub then refuses.
target/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Runtime data and logs
data/
logs/
*.log

# Editors and OS
.DS_Store
.idea/
.vscode/

# Captures from the lab. What gets committed is the driver test written from
# a capture, not the raw text: fixtures live beside the parser they exercise.
lab/captured/

# containerlab runtime state: generated on deploy, and it contains a CA key
# and authorized_keys. Nothing here is source.
lab/clab-*/

# Design archives and binary assets
nogglass-design.tar.gz
*.tar.gz
