# NOGGlass Environment Configuration (Optional / Legacy Overrides)
#
# As of v1.2.0, environment files are no longer required:
# - Router passwords can be configured directly in routers.conf (password = "...")
# - Server address and captcha secret can be set in nogglass.conf under [server]
# - Default config path /etc/nogglass/nogglass.conf is built directly into the binary
#
# Any environment variables set here will still take precedence as runtime overrides:
# NOGGLASS_CONFIG=/etc/nogglass/nogglass.conf
# NOGGLASS_HTTP_ADDR=0.0.0.0:8080
# NOGGLASS_CAPTCHA_SECRET="generate_a_random_secret_string_here_32_chars_or_more"
