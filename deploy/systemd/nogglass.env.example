# NOGGlass Environment Configuration File
# Copy to: /etc/nogglass/nogglass.env
# Permissions: chmod 0600 /etc/nogglass/nogglass.env
# Ownership: chown nogglass:nogglass /etc/nogglass/nogglass.env

# Path to the main configuration file
NOGGLASS_CONFIG=/etc/nogglass/nogglass.toml

# Listening address and port (default :8080)
NOGGLASS_HTTP_ADDR=0.0.0.0:8080

# Router credentials referenced in nogglass.toml (password_env / passphrase_env)
# NOGGLASS_EDGE01_PASSWORD="your_router_password_here"
# NOGGLASS_BORDER02_PASSPHRASE=""

# Captcha HMAC secret key (random 32+ characters recommended to prevent ephemeral startup key warning)
# NOGGLASS_CAPTCHA_SECRET="generate_a_random_secret_string_here_32_chars_or_more"
